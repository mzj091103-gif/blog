{
  "name": "tradeflow-cloud",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir .build",
    "configure": "node scripts/configure.mjs",
    "migrate": "wrangler d1 migrations apply tradeflow --remote --config wrangler.generated.json",
    "deploy": "wrangler deploy --config wrangler.generated.json",
    "backup": "node scripts/backup.mjs"
  },
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@11.25.0",
  "dependencies": { "jose": "6.2.12" },
  "devDependencies": { "wrangler": "4.151.0" }
}
